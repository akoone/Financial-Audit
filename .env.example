# Required: token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# Leave empty so anyone can use the bot (each user has fully separate data).
# Or list Telegram user IDs to make it private, e.g. 111111111,222222222
ALLOWED_USER_IDS=
# Max AI requests per user per day (receipts, alerts, summaries, questions). Protects your AI bill.
AI_DAILY_LIMIT=40

# Database. Leave empty for the default: bundled PostgreSQL with Docker Compose,
# or a local SQLite file when run with plain Python.
# For Neon / Supabase, paste their connection string as is, e.g.
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# AI (receipts, bank alerts, summaries, suggestions). Leave empty to run without AI.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Free OCR languages for receipts when no AI key is set (Tesseract)
OCR_LANGS=eng+rus+uzb+uzb_cyrl

# Defaults for new users (each user can change these in the bot)
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC

# Public HTTPS URL where the web server (port 8080) is reachable.
# Needed for the Mini App (the "Open app" button) and the bank-alert endpoint.
# On Render leave it empty: Render's own https://....onrender.com address is used automatically.
WEBAPP_URL=
WEB_PORT=8080
# How messages arrive: auto (webhook on Render, polling elsewhere), polling, or webhook (needs WEBAPP_URL)
BOT_MODE=auto
